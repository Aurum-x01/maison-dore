PORT=3000
NODE_ENV=development

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=maison_dore

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorized JavaScript origins must include http://localhost:3000
GOOGLE_CLIENT_ID=
